
[
  {
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": [
      "custom/ws1",
      "custom/ws2",
      "custom/ws3",
      "custom/ws4",
      "custom/search"
    ],

    "modules-center": ["clock"],

    "modules-right": [
      "keyboard-state",
      "tray",
      "pulseaudio",
      "battery",
      "custom/power"
    ],

    "custom/search": {
      "format": "Applications",
      "on-click": "rofi -show drun",
      "return-type": "text",
      "interval": "once"
    },

    "tray": {
      "icon-size": 18,
      "spacing": 6
    },

    "clock": {
      "format": "{:%a %d %b, %H:%M}  󰂚 ",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "interval": 60,
      "on-click": "swaync-client -t"
    },

    "pulseaudio": {
      "format": "{icon}   {volume}%",
      "format-muted": " Muted",
      "format-icons": {
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol",
      "scroll-step": 5
    },

    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": ["", "", "", "", ""],
      "states": {
        "warning": 20,
        "critical": 10
      }
    },

    "custom/power": {
      "format": "⏻",
      "on-click": "wlogout &",
      "tooltip": false
    },

    "custom/ws1": {
      "exec": "~/.local/bin/wayfire-workspaces 0",
      "return-type": "json",
      "interval": 1,
      "on-click": "~/.local/bin/wayfire-workspaces click 0"
    },

    "custom/ws2": {
      "exec": "~/.local/bin/wayfire-workspaces 1",
      "return-type": "json",
      "interval": 1,
      "on-click": "~/.local/bin/wayfire-workspaces click 1"
    },

    "custom/ws3": {
      "exec": "~/.local/bin/wayfire-workspaces 2",
      "return-type": "json",
      "interval": 1,
      "on-click": "~/.local/bin/wayfire-workspaces click 2"
    },

    "custom/ws4": {
      "exec": "~/.local/bin/wayfire-workspaces 3",
      "return-type": "json",
      "interval": 1,
      "on-click": "~/.local/bin/wayfire-workspaces click 3"
    }
  }
]
